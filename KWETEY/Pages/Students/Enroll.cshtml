<div class="onboarding-stepper" style="display:flex; justify-content:space-between; margin-bottom:40px; position:relative;">
    <div class="step active"><span>1</span><label>Personal</label></div>
    <div class="step"><span>2</span><label>Guardian</label></div>
    <div class="step"><span>3</span><label>Academic</label></div>
    <div class="step"><span>4</span><label>Finance</label></div>
</div>

<div class="enroll-content" style="background:white; border-radius:20px; padding:40px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">
        <h2>Student Profile</h2>
        <div class="id-badge" style="background:#00b0f0; color:white; padding:10px 20px; border-radius:12px; font-family:monospace; font-weight:900;">
            <i class="fas fa-qrcode"></i> @Model.AutoGeneratedId
        </div>
    </div>

    <form class="field-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
        <div class="input-wrapper">
            <label>First Name</label>
            <input type="text" class="premium-input" />
        </div>
        <div class="input-wrapper">
            <label>Last Name</label>
            <input type="text" class="premium-input" />
        </div>
        <div style="grid-column: span 2; display:flex; justify-content:flex-end; margin-top:30px;">
            <button class="btn-save" style="background:#f39c12; color:white; padding:15px 40px; border-radius:12px; border:none; font-weight:800;">
                Continue to Guardian <i class="fas fa-arrow-right"></i>
            </button>
        </div>
    </form>
</div>