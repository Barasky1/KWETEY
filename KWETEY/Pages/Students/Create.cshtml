@page
@model CreateModel
@{
    ViewData["Title"] = "Add Student";
}

<h2>Add Student</h2>

<form method="post">
    <div>
        <label>Name</label><br />
        <input asp-for="Student.Name" />
    </div>

    <div>
        <label>Class</label><br />
        <input asp-for="Student.Class" />
    </div>

    <div>
        <label>Gender</label><br />
        <select asp-for="Student.Gender">
            <option>Male</option>
            <option>Female</option>
        </select>
    </div>

    <br />

    <button type="submit">Save</button>
</form>